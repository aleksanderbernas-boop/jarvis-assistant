# ─────────────────────────────────────────────────────────────────────────────
# J.A.R.V.I.S. configuration. Copy to `.env` and fill in. `.env` is gitignored.
# Secrets live ONLY here (or in real environment variables) — never in code.
# ─────────────────────────────────────────────────────────────────────────────

# live = real tools and APIs. mock = simulated tools, fake web, scripted LLM,
# nothing on your computer is modified. Great for development.
JARVIS_MODE=live

# ── Reasoning engine (LLM) ───────────────────────────────────────────────────
# groq | openai | openai_compatible | mock
JARVIS_LLM_PROVIDER=groq
GROQ_API_KEY=
# OPENAI_API_KEY=
# For openai_compatible (Ollama, LM Studio, OpenRouter...):
# JARVIS_LLM_BASE_URL=http://localhost:11434/v1
# JARVIS_LLM_API_KEY=

# Model strategy — small/fast for routine work, bigger for planning/research.
# Run `python -m jarvis models` to list what your key can use.
JARVIS_MODEL_FAST=llama-3.1-8b-instant
JARVIS_MODEL_GENERAL=llama-3.3-70b-versatile
JARVIS_MODEL_REASONING=openai/gpt-oss-120b
JARVIS_MODEL_VISION=meta-llama/llama-4-scout-17b-16e-instruct

# ── Voice ────────────────────────────────────────────────────────────────────
# Speech-to-text: groq (Whisper, recommended) | browser (Web Speech API) | none
JARVIS_STT_PROVIDER=groq
JARVIS_STT_MODEL=whisper-large-v3-turbo
# Leave empty for auto-detect, or force e.g. en / pl
JARVIS_STT_LANGUAGE=
# Text-to-speech: browser (free, instant) | groq | elevenlabs | openai
JARVIS_TTS_PROVIDER=browser
# JARVIS_TTS_MODEL=
# JARVIS_TTS_VOICE=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

JARVIS_WAKE_WORDS=jarvis,hey jarvis
JARVIS_REQUIRE_WAKE_WORD=true
# Seconds after JARVIS answers during which you can follow up without the wake word
JARVIS_CONVERSATION_WINDOW_S=15

# ── You ──────────────────────────────────────────────────────────────────────
JARVIS_HONORIFIC=sir
# JARVIS_USER_NAME=
JARVIS_LOCATION_NAME=Kraków, PL
JARVIS_LATITUDE=50.0614
JARVIS_LONGITUDE=19.9372

# ── Permissions ──────────────────────────────────────────────────────────────
# Folders JARVIS may touch (separate with ; ). Defaults to your home folder.
# JARVIS_ALLOWED_PATHS=C:\Users\you\Documents;C:\Users\you\Downloads
JARVIS_ALLOW_WEB=true
JARVIS_ALLOW_CLIPBOARD=true
# Keyboard/mouse automation (needs `pip install pyautogui`)
JARVIS_ALLOW_INPUT_CONTROL=false
# Screen analysis sends a screenshot to the vision model provider.
JARVIS_ALLOW_VISION=false
# Ask before medium-risk actions (moving files, overwriting, closing apps with force...)
JARVIS_CONFIRM_MEDIUM_RISK=true
# Comma-separated tool names to disable entirely
# JARVIS_DISABLED_TOOLS=type_text,mouse_action

# ── Web research ─────────────────────────────────────────────────────────────
# duckduckgo (no key) | tavily | brave
JARVIS_SEARCH_PROVIDER=duckduckgo
# TAVILY_API_KEY=
# BRAVE_API_KEY=

# ── Server ───────────────────────────────────────────────────────────────────
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
JARVIS_LOG_LEVEL=INFO
